<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Notification permission — required on Android 13+ (API 33+).
         On older versions this permission is not needed and is ignored. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Exact alarm permissions:
         SCHEDULE_EXACT_ALARM — user-grantable permission for Android 12+ (API 31+).
         USE_EXACT_ALARM — auto-granted for qualifying alarm/calendar apps (API 33+).
         Both are declared; the system uses whichever applies to the device API level.
         AlarmScheduler gracefully falls back to inexact alarms if neither is granted. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>

    <!-- Wake lock — allows AlarmManager to wake the CPU when alarm fires. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <!-- Boot completed — allows BootReceiver to restore alarm after reboot. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <!-- Vibration — used by notification channel. -->
    <uses-permission android:name="android.permission.VIBRATE"/>

    <application
        android:label="PayDay"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:enableOnBackInvokedCallback="true">

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.updateprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths"/>
        </provider>

        <!-- Main Flutter activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- ReminderActivity — shown ONLY when phone is unlocked.
             android:showOnLockScreen="false": prevents showing over lock screen.
             android:exported="false": not accessible from other apps.
             android:excludeFromRecents="true": does not appear in recent apps.
             android:turnScreenOn="true": can wake screen when phone is unlocked.
             FLAG_SHOW_WHEN_LOCKED is intentionally NOT set in the manifest or code. -->
        <activity
            android:name=".ReminderActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:showOnLockScreen="false"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:taskAffinity=".reminder"
            android:launchMode="singleInstance"/>

        <!-- AlarmReceiver — fires at scheduled alarm time.
             android:exported="false": only this app can trigger it.
             The intent-filter action matches the PendingIntent in AlarmScheduler. -->
        <receiver
            android:name=".AlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.payday.ALARM_TRIGGER"/>
            </intent-filter>
        </receiver>

        <!-- WorkActionReceiver — handles YES/NO notification action buttons.
             android:exported="false": only this app can trigger it. -->
        <receiver
            android:name=".WorkActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="com.payday.ACTION_WORKED"/>
                <action android:name="com.payday.ACTION_NOT_WORKED"/>
            </intent-filter>
        </receiver>

        <!-- BootReceiver — restores alarm schedule after device reboot.
             android:exported="true": required for system to deliver BOOT_COMPLETED.
             android:permission: restricts delivery to system-level senders only. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter android:priority="999">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED"/>
                <action android:name="android.intent.action.TIME_SET"/>
                <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Flutter embedding version -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>
    </application>
</manifest>